---
import BaseLayout from "../layouts/BaseLayout.astro";

const checks = [
  { title: "Terrain", copy: "How high the ground sits, and what kind of land it is." },
  { title: "Flood", copy: "BNPB's hazard index, plus elevation and nearby water." },
  { title: "Hazards", copy: "Eleven InaRISK layers, from landslide to liquefaction." },
  { title: "History", copy: "Quakes, floods and eruptions recorded around that point." },
  { title: "Nearby", copy: "Clinics, schools, markets and transport within reach." },
  { title: "Overall", copy: "One coarse read, with every factor behind it shown." },
];
---

<BaseLayout>
  <div class="relative isolate">
    <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 ">
      <div class="">
        <div
          aria-hidden="true"
          class="tilik-map-field pointer-events-none absolute inset-y-0 -top-67.5 right-0 -z-10 w-[60%]"
        >
        </div>

        <section class="max-w-2xl pt-12 pb-10 sm:pt-20">
        <div class="flex items-center gap-3">
          <span class="h-0.5 w-9 rounded-full bg-clay-500"></span>
          <p class="tilik-eyebrow text-olive-600">Indonesia</p>
        </div>

        <h1 class="mt-4 font-display text-[2.7rem] leading-[1.0] text-olive-700 sm:text-[4rem]">
          Before you buy the land,<br class="hidden sm:block" />
          <span class="text-clay-600">check the ground.</span>
        </h1>

        <p class="mt-5 max-w-lg text-[0.95rem] leading-relaxed text-ink-soft">
          Search a place, paste coordinates, or drop a pin, then get the
          boring-but-important stuff: how high it sits, whether water is a problem,
          and what's happened there before.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a
            href="/explore"
            class="font-display inline-flex h-12 items-center gap-2 rounded-full bg-olive-500 px-6 text-sm font-medium text-paper shadow-lift transition-colors hover:bg-olive-600"
          >
            Check a location
          </a>
          <a
            href="/guideline"
            class="font-display inline-flex h-12 items-center rounded-full border border-line bg-paper-raised px-5 text-sm text-ink transition-colors hover:border-line-strong"
          >
            How it works
          </a>
        </div>
        </section>
      </div>

      <section id="what-we-check" class="scroll-mt-6  mt-20 pb-4">
       
        <div class="flex items-center gap-3">
          <span class="h-0.5 w-9 rounded-full bg-clay-500"></span>
          <p class="tilik-eyebrow text-olive-600">What you get</p>
        </div>

        <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2">
         
          <h2 class="font-display text-[1.9rem] leading-tight text-olive-700 sm:text-[2.2rem]">
            What a check <span class="text-clay-600">covers</span>
          </h2>

          <p class="tilik-figure text-xs text-ink-faint font-medium">
            {checks.length} readings &middot; one request
          </p>
        </div>

        <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-soft">
          Every figure carries its source, so you can tell a measurement from an
          estimate before you act on it.
        </p>

        <ul class="mt-7 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
          {
            checks.map((item, index) => (
              <li class="border-t-2 border-olive-200 pt-4">
                <p class="tilik-index text-clay-700">{String(index + 1).padStart(2, "0")}</p>
                <p class="mt-2 text-sm font-medium tracking-tight text-ink">{item.title}</p>
                <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">{item.copy}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
