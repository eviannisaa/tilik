# ---------------------------------------------------------------------------
# Tilik environment
#
# Copy to `.env` and fill in what you need. Every value below has a working
# default, so an empty file still runs — the defaults point at free, key-less
# public endpoints.
#
# NEVER put a secret in a PUBLIC_* variable: those are compiled into the
# browser bundle.
# ---------------------------------------------------------------------------

# --- Frontend (browser-visible) --------------------------------------------
# MapLibre style URL. Any key-less style works; if you use a provider that
# needs a key, proxy it through the API rather than exposing it here.
#
# Free OpenFreeMap styles, brightest first:
#   .../styles/liberty   colourful, warm off-white base   (default)
#   .../styles/bright    softer palette, more label detail
#   .../styles/positron  near-greyscale, very minimal
#   .../styles/fiord     dark
PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Leave blank when the API is served from the same domain (the Vercel setup).
PUBLIC_API_BASE_URL=

# Where the map opens before anything is selected.
PUBLIC_DEFAULT_LAT=-6.9175
PUBLIC_DEFAULT_LNG=107.6191
PUBLIC_DEFAULT_ZOOM=11

# --- Database (optional) ----------------------------------------------------
# PostgreSQL + PostGIS, e.g. from Supabase. Without it the API still works;
# spatial layers just fall back to external providers.
# Use the connection-pooler URI on serverless.
DATABASE_URL=

# --- Geocoding --------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Nominatim's usage policy requires an identifying User-Agent. Change this.
NOMINATIM_USER_AGENT=tilik/0.1 (+https://github.com/your-org/tilik)
NOMINATIM_EMAIL=

# --- Elevation --------------------------------------------------------------
# Primary: OpenTopography. Get a free key at portal.opentopography.org
# ("Request an API key"). Without it Tilik silently uses the fallback below.
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_API_URL=https://portal.opentopography.org/API/globaldem
# SRTMGL1 = 30 m global. SRTMGL3 (90 m) is lighter; NASADEM is also available.
OPENTOPOGRAPHY_DEM_TYPE=SRTMGL1

# Fallback: any endpoint returning {"results":[{"elevation": <metres>}]}.
ELEVATION_API_URL=https://api.opentopodata.org/v1/srtm30m

# --- Hazard indices (BNPB InaRISK) -------------------------------------------
# Official Indonesian national hazard model, no key needed. Eight layers, each
# scored 0..1: flood, flash flood, landslide, earthquake, liquefaction, tsunami,
# waves & erosion, volcanic eruption.
#
# Prefer ingesting the area you serve into PostGIS — BNPB's server is slow and
# intermittently unavailable, and a local ST_Intersects is neither:
#   python scripts/import_inarisk.py --bbox 107.5,-7.0,107.8,-6.8
#
# These settings only matter for points with no ingested coverage, which fall
# through to the live ImageServers.
INARISK_BASE_URL=https://gis.bnpb.go.id/server/rest/services/inarisk
INARISK_TIMEOUT_SECONDS=8
# Fallback search radius for hazards without a specific one. Each hazard has its
# own radius in api/services/inarisk.py (HAZARD_RADIUS_M), because they are
# geographically different: flood and seismic hazard are broad surfaces where the
# plot's own pixel is the answer, while tsunami and coastal erosion are thin
# bands at the shoreline, landslide follows hillslopes, and volcanic hazard rings
# a mountain. Every reading reports how far away its value was found.
INARISK_NEIGHBOURHOOD_METERS=500

# --- Disasters --------------------------------------------------------------
# Earthquakes: real epicentres, free, no key.
EARTHQUAKE_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query

# Everything USGS structurally can't report — floods, volcanic eruptions,
# wildfires, cyclones, droughts. Free, no key.
GDACS_API_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/SEARCH
GDACS_ALERT_LEVELS=Green;Orange;Red
# Restrict the feed to one country, or leave blank for worldwide.
GDACS_COUNTRY=Indonesia
# Wider than DISASTER_RADIUS_METERS on purpose: GDACS locates events by area
# centroid, so a flood 80 km away may be the same event that reached this area.
GDACS_RADIUS_METERS=150000
# Nearest N events kept per hazard type, so a busy seismic record can't crowd
# floods and eruptions out of the list.
DISASTER_EVENTS_PER_TYPE=3
# Optional GeoJSON feed of extra events. Blank = skipped.
#
# BNPB's DIBI has no public API (it's an authenticated Superset dashboard), so
# for DIBI data export a CSV and load it into PostGIS instead:
#   python scripts/import_disasters.py path/to/dibi-export.csv
DISASTER_API_URL=
DISASTER_RADIUS_METERS=50000
DISASTER_YEARS=25
DISASTER_MIN_MAGNITUDE=4.5
# Depth cutoff for quakes the catalogue gives no intensity or felt report for.
# Java sits above a subducting slab producing a steady stream of magnitude 4-5
# events at 130-190 km, which reach the surface as nothing: within 200 km of
# Serpong a third of the USGS catalogue is that deep. Events with real intensity
# or felt evidence are kept at any depth. Raise past 700 to disable.
DISASTER_MAX_DEPTH_KM=70

# --- Local news ------------------------------------------------------------
# Google News RSS. Free, no key. GDELT was tested and rejected: it rate-limits
# to one request per 5 seconds per IP, which serverless functions can't honour.
GOOGLE_NEWS_RSS_URL=https://news.google.com/rss/search
# Feed edition. id/ID gets Indonesian-language local reporting.
NEWS_LANGUAGE=id
NEWS_COUNTRY=ID
# How far back to search, in months. Rendered into Google's `when:` operator as
# days — its `m` unit means *minutes*, and silently returns an empty feed.
NEWS_MONTHS=12
NEWS_MAX_ITEMS=12
# Drop the news section without disabling every other provider.
ENABLE_NEWS=true

# --- Air quality (WAQI) ------------------------------------------------------
# World Air Quality Index. A feed that takes a coordinate directly, a free token
# with a 1,000 req/s quota, and the only instrument reading in this report:
# everything else is a model or a catalogue.
#
# Its Indonesian coverage is 25 stations, all of them BMKG's, one per region
# rather than one per city. Jakarta, Semarang, Yogyakarta, Palembang, Medan,
# Makassar, Bekasi and Tangerang Selatan are within 25 km of one. Surabaya is
# 79 km away, Balikpapan 90 km, Bandung 120 km, Denpasar 297 km. DKI's own AQMS
# network is not in this feed.
#
# Get a token at https://aqicn.org/data-platform/token (email + domain, instant).
# THIS IS A SECRET. Never move it to a PUBLIC_* name: those are compiled into
# the browser bundle. Left blank, the air-quality section reports itself as not
# configured and every other section is unaffected.
WAQI_API_TOKEN=
WAQI_API_URL=https://api.waqi.info/feed

# WAQI answers with the nearest station, not with your coordinate, and it never
# says how far that is. Tilik computes the distance and reports it. Past this
# figure the reading is still shown, with its distance and a lowered confidence,
# because a far reading beats a blank section as long as the reader can see
# where it came from.
WAQI_MAX_STATION_METERS=25000

# No reading is withheld for being far away. A cutoff was tried and removed: it
# left most of the country with a blank section, and a distant reading shown with
# its distance beats no reading at all. Distance changes the wording and the
# confidence badge, never whether the figure appears.

# Drop the air-quality section without disabling every other provider.
ENABLE_AIR_QUALITY=true

# --- Geographic features ----------------------------------------------------
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
WATERWAY_RADIUS_METERS=2000
# "What's nearby" lookup: hospitals, schools, shops, transport, and so on.
PLACES_RADIUS_METERS=1500
PLACES_PER_CATEGORY=3

# --- Behaviour --------------------------------------------------------------
ENVIRONMENT=development
EXTERNAL_TIMEOUT_SECONDS=8
# Set to false to run fully offline against clearly-labelled sample data.
ENABLE_EXTERNAL_APIS=true
CACHE_TTL_SECONDS=900
RATE_LIMIT_PER_MINUTE=60
# Comma-separated origins. "*" is fine while the API is same-origin only.
CORS_ALLOW_ORIGINS=*
